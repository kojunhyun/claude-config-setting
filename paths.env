# Claude Config — shared paths/names (git tracked, multi-machine sync)
# -------------------------------------------------------------------
# bootstrap.{sh,ps1} 가 셸 rc 에 source 라인을 박아두므로 이 파일은
# 셸 시작 시 자동으로 로드된다 (bash/zsh + PowerShell 양쪽 호환).
#
# 문법: KEY=value  (한 줄)
#   - 값에 공백/특수문자 있으면 반드시 따옴표 (예: KEY="공백 있는 값")
#   - 양쪽 셸 호환 위해 $VAR expansion / 명령 치환 사용 금지
#   - 값이 비어있으면 SKILL.md 의 기본 fallback 사용
#   - 주석은 #
#
# 머신별 override 가 필요하면 같은 폴더에 paths.local.env 생성
# (gitignored). 같은 키를 paths.env 다음에 덮어쓴다.

# ============================================================
# Git identity + SSH (한 곳에서 관리)
# ------------------------------------------------------------
# 새 PC 셋업할 때 손대야 할 git/SSH 항목의 single source of truth.
# bootstrap 이 SSH key 자동 생성, /setup-status 가 나머지 점검.
# ============================================================

# --- 개인 (default 계정) -----------------------------------
GIT_PERSONAL_NAME="고준현"
GIT_PERSONAL_EMAIL="skykjh200@naver.com"
GIT_PERSONAL_KEY_NAME="id_ed25519"            # ~/.ssh/<KEY_NAME>
GIT_PERSONAL_HOSTS="github.com"               # 콤마 구분, 이 호스트들은 개인 키 사용

# --- 회사 (work) -------------------------------------------
GIT_WORK_NAME="고준현"
GIT_WORK_EMAIL="jhko@aixera.co.kr"
# 회사 GitLab (gitlab.aixera.net) 은 Cloudflare tunnel 뒤에 있어 SSH 22 직접
# 차단됨. HTTPS+PAT 방식 사용 (~/.git-credentials 에 store). SSH 비활성:
GIT_WORK_KEY_NAME=""
GIT_WORK_HOSTS=""
# (cloudflared tunnel 셋업하면 SSH 도 가능 — 그 때 위 두 값 활성화)

# 회사 repo 들이 들어가는 폴더 패턴 (gitconfig includeIf gitdir 패턴).
# 빈값이면 OS 자동 감지. paths.local.env 에서 머신별 override 가능.
# 이 머신은 PROJECTS_DIR(=00_Project) 가 사실상 회사 메인 작업 폴더.
GIT_WORK_DIR=~/00_Project

# --- 공통 -------------------------------------------------
GIT_CREDENTIAL_HELPER="store"                 # HTTPS push 시 token 저장 방식

# bootstrap 이 crontab 자동 작성할지. false 면 사용자가 수동 crontab -e 로.
# (기본 true — paths.local.env 에서 머신별 false 로 override 가능)
BOOTSTRAP_AUTO_CRONTAB="true"

# ============================================================
# 멀티 머신 운영 — 모든 머신은 paths.local.env 에 다음 변수 정의 필수.
# bootstrap 이 paths.local.env 없으면 hostname-user 디폴트로 자동 생성.
# ============================================================

# 이 머신의 고유 식별자. daily-log 파일/페이지 분리 기준.
# 비우면 SKILL 이 hostname 으로 fallback (충돌 위험 — 비추).
# 권장: paths.local.env 에서 "jhko-wsl-desktop" 같이 의미있는 이름.
CLAUDE_MACHINE_ID="jhko-mac-mini"

# weekly-log 통합을 누가 할지. 메인 머신 한 대만 paths.local.env 에서
# CLAUDE_WEEKLY_LEADER=true 로 설정. 나머지 머신에서 /weekly-log 호출
# 하면 자기 머신 데이터만 정리하고 종료.
CLAUDE_WEEKLY_LEADER=true

# ============================================================
# 스케줄 정책 (system cron + /schedule 양쪽 공통 가드)
# ------------------------------------------------------------
# 각 자동 스킬이 어떤 머신에서 실행되어야 하는지 콤마 구분 목록으로 명시.
# 빈 값이면 모든 머신 허용. routine 이 호출돼도 자기 MACHINE_ID 가
# 목록에 없으면 즉시 exit 0 (no-op).
#
# 시스템 cron 으로 격리해도 이 가드는 추가 안전망 역할.
# /schedule (claude.ai routine) 이 모든 머신에서 트리거되어도 가드가 차단.
# ============================================================

# Leader 머신 단일 명시 (모든 머신 공통). aggregate / weekly 가 이 ID 와 자기
# CLAUDE_MACHINE_ID 가 일치할 때만 실행. paths.local.env 의 CLAUDE_WEEKLY_LEADER
# 가 true 라도 LEADER_MACHINE 와 다르면 skip (이중 안전).
LEADER_MACHINE="jhko-mac-mini"

# /config-push 자동 실행 허용 머신 (빈값=모든 머신, 권장: 메인 머신만)
SCHEDULE_PUSH_MACHINES=""

# /config-sync 자동 실행 허용 머신 (빈값=모든 머신, 일반적으로 비워둠)
SCHEDULE_SYNC_MACHINES=""

# /daily-log 자동 실행 허용 머신 (빈값=모든 머신, 자기 작업 정리이므로 모두 OK)
SCHEDULE_DAILY_MACHINES=""

# daily-log-aggregate / weekly-log 는 CLAUDE_WEEKLY_LEADER 로 이미 게이트됨

# ============================================================
# daily-log / weekly-log
# ============================================================

# --- Obsidian -----------------------------------------------
# 빈 값이면 SKILL fallback ($OBSIDIAN_DIR/Claude_Logs/*) 사용.
# 머신별로 다르게 쓰고 싶으면 paths.local.env 에서 절대경로로 지정.
CLAUDE_LOG_OBS_DAILY=
CLAUDE_LOG_OBS_DAILY_RAW=    # 비우면 $CLAUDE_LOG_OBS_DAILY/raw 사용
CLAUDE_LOG_OBS_WEEKLY=

# --- Notion: 멀티 타겟 (개인 + 회사 동시 업로드) ----------
# 인증 방식: Notion Internal Integration Token (REST API).
# 각 워크스페이스마다 integration 만들고 token 발급 후 paths.local.env 에 secret 저장.
# 자세한 발급 절차는 SETUP.md "Notion Integration Token 셋업" 참고.

# 활성 타겟 콤마 구분. 비우면 default 단일 타겟.
# 2026-05-28: work(팀스페이스) 제거 — 개인 계정(뽀고)에만 업로드.
# 2026-06-22: 정책 확정 — 개인(skykjh20@gmail.com) 단일 업로드 유지, 회사 업로드 안 함.
CLAUDE_LOG_NOTION_TARGETS=personal

# --- 개인 워크스페이스 = skykjh20@gmail.com ---
# 공통(이름 등): paths.env 에서 관리
CLAUDE_LOG_NOTION_PERSONAL_PARENT="Claude-Work"
CLAUDE_LOG_NOTION_PERSONAL_PARENT_ID=
# Secret: paths.local.env 에서 관리 — 이 파일에는 넣지 말 것!
# 예) CLAUDE_LOG_NOTION_PERSONAL_TOKEN="secret_xxx..."

# --- 회사 워크스페이스 (비활성 — TARGETS 에서 제외됨, 2026-06-22) ---
CLAUDE_LOG_NOTION_WORK_PARENT="Claude Logs"
CLAUDE_LOG_NOTION_WORK_PARENT_ID=
# Secret: paths.local.env 에서 관리
# 예) CLAUDE_LOG_NOTION_WORK_TOKEN="secret_yyy..."

# --- default 타겟 (단일 워크스페이스 쓸 때) -----------------
# TARGETS 가 비어있을 때만 사용. 현재 멀티 타겟이라 무시됨.
CLAUDE_LOG_NOTION_DEFAULT_PARENT=
CLAUDE_LOG_NOTION_DEFAULT_PARENT_ID=
# CLAUDE_LOG_NOTION_DEFAULT_TOKEN= (paths.local.env)

# --- 하위 호환 (단일 Notion 쓸 때, default 와 동일) ----------
# 아래 두 변수는 _DEFAULT_PARENT / _DEFAULT_PARENT_ID 의 별칭.
CLAUDE_LOG_NOTION_PARENT=
CLAUDE_LOG_NOTION_PARENT_ID=
