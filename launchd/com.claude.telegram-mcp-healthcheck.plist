<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.claude.telegram-mcp-healthcheck</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__SCRIPT__</string>
    </array>
    <key>StartInterval</key><integer>120</integer>
    <key>RunAtLoad</key><false/>
    <key>StandardOutPath</key><string>__HOME__/.claude/logs/telegram-mcp-healthcheck.stdout.log</string>
    <key>StandardErrorPath</key><string>__HOME__/.claude/logs/telegram-mcp-healthcheck.stderr.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key><string>__HOME__</string>
        <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
